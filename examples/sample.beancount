2020-01-01 query "Annual contributions: HSA via Personal Contributions" "
  SELECT
    year(date) as year,
    sum(convert(position, 'USD')) as amount
  WHERE
    account = 'Assets:Investments:HSA:Fidelity:FDRXX' AND
    other_accounts ~ 'Assets:Banks:Checking'
  GROUP BY year
  ORDER BY year
"

2020-01-01 query "Annual contributions: HSA via Paycheck Deductions" "
  SELECT
    year(date) as year,
    account,
    sum(convert(position, 'USD')) as amount
  WHERE
    account ~ '^Assets:Investments:HSA' AND
    other_accounts ~ '^Income:Employment'
  GROUP BY year, account
  ORDER BY year, account
"

2020-01-01 query "Annual contributions: Roth" "
  SELECT
    year(date) as year,
    account,
    number(sum(position)) as number
  WHERE
    account ~ '^Assets:Investments:Tax-Free:SchwabRoth' AND
    other_accounts ~ 'Assets:Banks:Checking'
  GROUP BY year, account
  ORDER BY year, account
"
